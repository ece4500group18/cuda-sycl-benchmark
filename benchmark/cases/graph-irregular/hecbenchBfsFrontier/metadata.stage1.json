{
  "id": "hecbenchBfsFrontier",
  "name": "HeCBench BFS frontier step",
  "domain": "hpc",
  "category": "graph-irregular",
  "difficulty": "hard",
  "source_project": "ORNL/HeCBench",
  "source_url": "https://github.com/ORNL/HeCBench/blob/master/src/bfs-cuda/bfs.cu",
  "license": "BSD-3-Clause",
  "adaptation_type": "simplified",
  "cuda_features": [
    "__global__",
    "graph",
    "frontier",
    "atomicMin"
  ],
  "description": "Single BFS frontier relaxation over a deterministic sparse graph, adapted from HeCBench/Rodinia BFS.",
  "input_description": "type=hashed; sizes=[4096, 3]; seed=123",
  "output_description": "CUDA executable writes numeric output to output/cuda_output.txt.",
  "verification": {
    "type": "cpu_reference",
    "rtol": 0.0,
    "atol": 0.0,
    "reference": "cpu",
    "notes": "cpu_reference"
  },
  "build": {
    "system": "custom_nvcc",
    "requires_gpu": true,
    "requires_external_libs": [],
    "command": "nvcc -O2 -std=c++17 original/main.cu -o original/build/app"
  },
  "run": {
    "command": "original/build/app output/cuda_output.txt",
    "output_files": [
      "output/cuda_output.txt"
    ],
    "expected_runtime_sec": ""
  },
  "performance": {
    "nvidia_baseline_required": true,
    "timing_available": true,
    "metric_type": "runtime",
    "primary_metric": "ms",
    "problem_size": [
      4096,
      3
    ],
    "notes": "Process-level elapsed time; kernel-level timers can be added per case."
  },
  "hardware": {
    "gpu_model": "NVIDIA GeForce RTX 3070 Ti Laptop GPU",
    "cuda_version": "12.1",
    "driver_version": "596.21"
  },
  "status": "perf_ready",
  "owner": "ece4500group18",
  "extraction_fidelity": "simplified",
  "extraction_notes": "Standalone graph frontier step inspired by ORNL/HeCBench src/bfs-cuda/bfs.cu.",
