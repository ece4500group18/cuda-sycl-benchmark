{
  "id": "monteCarloPi",
  "name": "Monte Carlo estimate of pi",
  "domain": "hpc",
  "category": "simple-kernels",
  "difficulty": "hard",
  "source_project": "ece4500group18/cuda-sycl-benchmark",
  "source_url": "https://github.com/ece4500group18/cuda-sycl-benchmark",
  "license": "MIT",
  "adaptation_type": "simplified",
  "cuda_features": [
    "__global__",
    "reduction",
    "atomicAdd"
  ],
  "description": "Hash-based samples in unit square; |est - pi|. sizes=[samples].",
  "input_description": "type=hashed; sizes=[4194304]; seed=123",
  "output_description": "CUDA executable writes numeric output to output/cuda_output.txt.",
  "verification": {
    "type": "invariant",
    "rtol": 0.03,
    "atol": 0.03,
    "reference": "invariant",
    "notes": "analytic_reference"
  },
  "build": {
    "system": "custom_nvcc",
    "requires_gpu": true,
    "requires_external_libs": [],
    "command": "nvcc -O2 -std=c++17 original/main.cu -o original/build/app"
  },
  "run": {
    "command": "original/build/app output/cuda_output.txt",
    "output_files": [
      "output/cuda_output.txt"
    ],
    "expected_runtime_sec": ""
  },
  "performance": {
    "nvidia_baseline_required": true,
    "timing_available": true,
    "metric_type": "runtime",
    "primary_metric": "ms",
    "problem_size": [
      4194304
    ],
    "notes": "Process-level elapsed time; kernel-level timers can be added per case."
  },
  "hardware": {
    "gpu_model": "NVIDIA GeForce RTX 3070 Ti Laptop GPU",
    "cuda_version": "12.1",
    "driver_version": "596.21"
  },
  "status": "perf_ready",
  "owner": "ece4500group18",
  "extraction_fidelity": "simplified",
  "extraction_notes": "Hash-based samples in unit square; |est - pi|. sizes=[samples].",
  "notes": "Hash-based samples in unit square; |est - pi|. sizes=[samples].",
