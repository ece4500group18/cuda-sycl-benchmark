      "identity_note": "CodeBuddy routes the alias 'minimax-m3' (from `codebuddy --model` supported list), not a dated immutable snapshot. Record `codebuddy --version` and the run timestamp alongside results."
    }
  ],
  "skill_conditions": [
    {"slug": "oob", "skill": null, "version": null},
    {
      "slug": "with-sycl-skill",
