{
  "schema_version": 2,
  "experiment_id": "trae-gpt-pilot-v1",
  "dataset_manifest": "benchmark/stage2/datasets/cuda_verified_250.json",
  "case_ids": [
    "vectorAdd", "transposeShared", "conv1dShared", "reduceSum", "bfs",
    "nbodyTiled", "tiledMatmul", "attention", "thrustSort", "histogram"
  ],
  "harnesses": [
    {
      "slug": "trae",
      "adapter": "external_command",
      "display_name": "TRAE CLI via OpenRouter",
      "argv": [
        "py",
        "-3",
        "{sandbox}\\trae_openrouter_wrapper.py",
        "--model",
        "{model_id}",
        "--working-dir",
        "{sandbox}",
        "--prompt-file",
        "{agent_prompt_file}",
        "--max-steps",
        "30",
        "--telemetry-file",
        "stage2_telemetry.json",
        "--trajectory-file",
        "stage2_trajectory.json"
      ],
      "telemetry_file": "stage2_telemetry.json"
    }
  ],
  "models": [
    {
      "slug": "gpt",
      "provider": "openai",
      "model_id": "gpt",
      "require_immutable_model_id": false,
      "identity_note": "The label 'gpt' is intentionally treated as a routing alias inside TRAE. Before scored comparisons, record the exact visible backend/model name, TRAE version/build, and run timestamp, or replace this alias with a narrower route if TRAE exposes one."
    }
  ],
  "skill_conditions": [
    {"slug": "oob", "skill": null, "version": null},
    {
      "slug": "with-sycl-skill",
      "skill": "benchmark/stage2/skills/cuda-to-sycl-migration",
      "version": "v1"
    }
  ],
  "matrix": {
    "include": [
      {"harness": "trae", "model": "gpt"}
    ]
  },
  "repeats": 1,
  "budget": {"max_iterations": 30, "max_tokens": 150000, "wall_clock_s": 3600},
  "executor": {
    "kind": "ssh",
    "target_env": "STAGE2_SSH_TARGET",
    "remote_root": "/tmp/cuda-sycl-benchmark-stage2",
    "setup_command": "source /opt/intel/oneapi/setvars.sh >/dev/null 2>&1",
    "device_selector": "level_zero:gpu",
    "gpu_slots": 1,
    "remote_timeout_s": 3600,
    "extra_sycl_flags": []
  },
  "reference_mode": "none",
  "prompt_version": "translation-task-v2"
}
