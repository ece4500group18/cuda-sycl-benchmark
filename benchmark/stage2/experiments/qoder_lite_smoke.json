{
  "schema_version": 2,
  "experiment_id": "qoder-lite-smoke-v1",
  "dataset_manifest": "benchmark/stage2/datasets/cuda_verified_250.json",
  "case_ids": [
    "vectorAdd"
  ],
  "harnesses": [
    {
      "slug": "qoder",
      "adapter": "external_command",
      "display_name": "Qoder CLI 1.1.3",
      "argv": [
        "/home/terry/.local/bin/qodercli",
        "-p",
        "--permission-mode",
        "bypass_permissions",
        "-m",
        "{model_id}",
        "-w",
        "{sandbox}",
        "--output-format",
        "json",
        "{prompt}"
      ]
    }
  ],
  "models": [
    {
      "slug": "lite",
      "provider": "qoder",
      "model_id": "lite",
      "require_immutable_model_id": false
    }
  ],
  "skill_conditions": [
    {
      "slug": "oob",
      "skill": null,
      "version": null
    },
    {
      "slug": "with-sycl-skill",
      "skill": "benchmark/stage2/skills/cuda-to-sycl-migration",
      "version": "v1"
    }
  ],
  "matrix": {
    "include": [
      {
        "harness": "qoder",
        "model": "lite"
      }
    ]
  },
  "repeats": 1,
  "budget": {
    "max_iterations": 30,
    "max_tokens": 150000,
    "wall_clock_s": 3600
  },
  "executor": {
    "kind": "ssh",
    "target_env": "STAGE2_SSH_TARGET",
    "remote_root": "/tmp/cuda-sycl-benchmark-stage2",
    "setup_command": "source /opt/intel/oneapi/setvars.sh >/dev/null 2>&1",
    "device_selector": "level_zero:gpu",
    "gpu_slots": 1,
    "remote_timeout_s": 3600,
    "extra_sycl_flags": []
  },
  "reference_mode": "none",
  "prompt_version": "canonical-agent-prompt-v1"
}
