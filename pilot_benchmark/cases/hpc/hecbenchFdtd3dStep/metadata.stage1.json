{
  "id": "hecbenchFdtd3dStep",
  "name": "HeCBench FDTD 3D step",
  "domain": "hpc",
  "category": "hpc",
  "difficulty": "hard",
  "source_project": "ORNL/HeCBench",
  "source_url": "https://github.com/ORNL/HeCBench/blob/master/src/fdtd3d-cuda/main.cu",
  "license": "BSD-3-Clause",
  "adaptation_type": "simplified",
  "cuda_features": [
    "__global__",
    "3D_indexing",
    "stencil",
    "time_step"
  ],
  "description": "Single 3D FDTD-style stencil update, adapted from HeCBench FDTD3D.",
  "input_description": "type=hashed; sizes=[48, 48, 32]; seed=123",
  "output_description": "CUDA executable writes numeric output to output/cuda_output.txt.",
  "verification": {
    "type": "cpu_reference",
    "rtol": 1e-05,
    "atol": 1e-05,
    "reference": "cpu",
    "notes": "cpu_reference"
  },
  "build": {
    "system": "custom_nvcc",
    "requires_gpu": true,
    "requires_external_libs": [],
    "command": "nvcc -O2 -std=c++17 original/main.cu -o original/build/app"
  },
  "run": {
    "command": "original/build/app output/cuda_output.txt",
    "output_files": [
      "output/cuda_output.txt"
    ],
    "expected_runtime_sec": ""
  },
  "performance": {
    "nvidia_baseline_required": true,
    "timing_available": true,
    "metric_type": "runtime",
    "primary_metric": "ms",
    "problem_size": [
      48,
      48,
      32
    ],
    "notes": "Process-level elapsed time; kernel-level timers can be added per case."
  },
  "hardware": {
    "gpu_model": "NVIDIA GeForce RTX 3070 Ti Laptop GPU",
    "cuda_version": "12.1",
    "driver_version": "596.21"
  },
  "status": "perf_ready",
  "owner": "ece4500group18",
  "notes": "Standalone 3D stencil inspired by ORNL/HeCBench src/fdtd3d-cuda/main.cu.",
  "legacy_metadata": {
    "file": "metadata.json",
    "declared_status": "raw"
  }
}
