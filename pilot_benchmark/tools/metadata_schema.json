{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pilot benchmark case metadata",
  "description": "Schema every cases/<category>/<case_id>/metadata.json must follow.",
  "type": "object",
  "required": [
    "case_id", "name", "category", "source", "cuda_features", "libraries",
    "input", "build", "run", "correctness", "syclomatic", "status", "notes"
  ],
  "properties": {
    "case_id": {"type": "string"},
    "name": {"type": "string"},
    "category": {"enum": ["easy", "medium", "hpc", "ai", "library_api"]},
    "source": {
      "type": "object",
      "required": ["type", "url", "license", "original_path"],
      "properties": {
        "type": {"type": "string", "description": "e.g. authored, cuda-samples, adapted"},
        "url": {"type": "string"},
        "license": {"type": "string"},
        "original_path": {"type": "string"}
      }
    },
    "cuda_features": {"type": "array", "items": {"type": "string"}},
    "libraries": {"type": "array", "items": {"type": "string"}},
    "input": {
      "type": "object",
      "required": ["type", "sizes", "seed"],
      "properties": {
        "type": {"type": "string", "description": "e.g. deterministic_formula, generated_file"},
        "sizes": {"type": "array", "items": {"type": "integer"}},
        "seed": {"type": "integer"}
      }
    },
    "build": {
      "type": "object",
      "required": ["cuda_build_command", "sycl_build_command"],
      "properties": {
        "cuda_build_command": {"type": "string"},
        "sycl_build_command": {"type": "string"}
      }
    },
    "run": {
      "type": "object",
      "required": ["cuda_run_command", "sycl_run_command"],
      "properties": {
        "cuda_run_command": {"type": "string"},
        "sycl_run_command": {"type": "string"}
      }
    },
    "correctness": {
      "type": "object",
      "required": ["method", "metric", "tolerance", "expected_pass_string"],
      "properties": {
        "method": {"type": "string", "description": "cpu_reference | cuda_reference | pass_string"},
        "metric": {"type": "string", "description": "max_abs_error | max_rel_error | exact | pass_string"},
        "tolerance": {"type": ["number", "null"]},
        "expected_pass_string": {"type": "string"}
      }
    },
    "syclomatic": {
      "type": "object",
      "required": ["status", "command", "warnings_count", "manual_fixes_required"],
      "properties": {
        "status": {"type": "string"},
        "command": {"type": "string"},
        "warnings_count": {"type": ["integer", "null"]},
        "manual_fixes_required": {"type": ["boolean", "null"]}
      }
    },
    "status": {
      "type": "object",
      "required": [
        "cuda_compile", "cuda_run", "cuda_verify", "syclomatic_migrate",
        "sycl_compile", "sycl_run", "sycl_verify"
      ],
      "properties": {
        "cuda_compile": {"type": "string"},
        "cuda_run": {"type": "string"},
        "cuda_verify": {"type": "string"},
        "syclomatic_migrate": {"type": "string"},
        "sycl_compile": {"type": "string"},
        "sycl_run": {"type": "string"},
        "sycl_verify": {"type": "string"}
      }
    },
    "notes": {"type": "string"}
  }
}
